# Copy this file to .env and adjust before running `docker compose up`.
# .env is gitignored — never commit real credentials.

# --- Database ---
DB_NAME=cellcraze
DB_USER=cellcraze
DB_PASSWORD=change-me-db-pass
DB_ROOT_PASSWORD=change-me-root-pass

# --- Site ---
WP_PORT=8080
SITE_URL=http://localhost:8080
SITE_TITLE=CellCraze

# --- Admin account (created on first setup) ---
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=change-me-admin-pass
WP_ADMIN_EMAIL=owner@cellcraze.lk

# --- Shop defaults (LKR) ---
# Flat-rate shipping cost and the order total above which shipping is free.
SHOP_FLAT_RATE=350
FREE_SHIPPING_MIN=10000
