# Local environment
.env

# Docker volume mountpoints (if ever bind-mounted locally)
db-data/
wp-data/

# WordPress core + uploads are NOT version controlled.
# We only track our own theme, scripts, and data.
wp-content/uploads/
# Ignore third-party plugins (installed from wordpress.org on the server)...
wp-content/plugins/*
# ...but DO track our own custom plugin.
!wp-content/plugins/cellcraze-core
wp-content/upgrade/
wp-content/cache/

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
